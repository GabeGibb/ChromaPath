{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/dist/index.js": {
      "maxDuration": 30
    }
  }
}
